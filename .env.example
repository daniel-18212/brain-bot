# =====================================================================
# BRAIN-BOT ENTERPRISE CONFIGURATION (TOP 4 ELITE ENGINES & SAAS)
# =====================================================================

# --- TELEGRAM BOT CREDENTIALS ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
ADMIN_USER_ID=123456789
ADMIN_CONTACT=@your_telegram_username

# Controle de Acesso: 'WHITELIST' (Recomendado para SaaS), 'PRIVATE' (Só Admin), ou 'PUBLIC'
ACCESS_MODE=WHITELIST
WHITELIST_USERS=123456789

# --- AS 4 CHAVES DE ELITE ---
# 1. DeepSeek API (Código e Raciocínio - https://platform.deepseek.com)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 2. Google Gemini (Visão, OCR e Texto - https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# 3. Groq Cloud (Áudio Whisper e GPT-OSS 120B - https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# 4. GitHub Models (GPT-4o Oficial - https://github.com/settings/tokens)
GITHUB_TOKEN=your_github_token_here

# --- PREFERÊNCIAS DO SISTEMA ---
DEFAULT_MODEL=deepseek
DATABASE_PATH=data/brain_bot.sqlite
MAX_CONTEXT_TURNS=20
STREAMING_THROTTLE_SECONDS=1.2
LOG_LEVEL=INFO
HEALTH_PORT=8080
