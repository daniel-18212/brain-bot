# =====================================================================
# BRAIN-BOT ENTERPRISE CONFIGURATION
# =====================================================================

# --- TELEGRAM SETTINGS ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
ADMIN_USER_ID=123456789

# Access Control: 'PRIVATE' (Admin only), 'WHITELIST' (Allowed list), 'PUBLIC' (SaaS open)
ACCESS_MODE=PRIVATE
WHITELIST_USERS=123456789,987654321

# --- FREE TIER & PAID AI PROVIDERS ---
# 1. Google Gemini (100% Free Tier - https://aistudio.google.com)
GEMINI_API_KEY=

# 2. Groq Cloud (100% Free Tier - Llama 3.3 70B & Whisper - https://console.groq.com)
GROQ_API_KEY=

# 3. DeepSeek (Ultra-low cost Pay-as-you-go - https://platform.deepseek.com)
DEEPSEEK_API_KEY=

# 4. OpenRouter (Optional - Free & Paid Multi-LLM Router - https://openrouter.ai)
OPENROUTER_API_KEY=

# 5. OpenAI (Optional - GPT-4o / Whisper)
OPENAI_API_KEY=

# --- BOT PREFERENCES ---
# Options: 'gemini' | 'groq' | 'deepseek' | 'deepseek-r1' | 'openrouter'
DEFAULT_MODEL=gemini
DATABASE_PATH=data/brain_bot.sqlite
MAX_CONTEXT_TURNS=20
STREAMING_THROTTLE_SECONDS=1.2
LOG_LEVEL=INFO
