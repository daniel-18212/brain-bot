# =====================================================================
# BRAIN-BOT ENTERPRISE CONFIGURATION (TOP 4 ELITE ENGINES)
# =====================================================================

# --- TELEGRAM BOT CREDENTIALS ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
ADMIN_USER_ID=123456789

# Controle de Acesso: 'PRIVATE' (Só Admin), 'WHITELIST' (Lista autorizada), 'PUBLIC' (SaaS aberto)
ACCESS_MODE=PRIVATE
WHITELIST_USERS=123456789

# --- AS 4 CHAVES DE ELITE ---
# 1. DeepSeek API (Seu motor principal V4 / V3 e R1 - https://platform.deepseek.com)
DEEPSEEK_API_KEY=

# 2. Google Gemini (100% Grátis: Gemini 2.0 Flash e 1.5 Pro - https://aistudio.google.com)
GEMINI_API_KEY=

# 3. Groq Cloud (100% Grátis: Llama 3.3 70B e Whisper Áudio - https://console.groq.com)
GROQ_API_KEY=

# 4. GitHub Models (100% Grátis: GPT-4o e GPT-4o-Mini via Azure - https://github.com/settings/tokens)
GITHUB_TOKEN=

# --- PREFERÊNCIAS DO SISTEMA ---
# Modelo Padrão: 'deepseek' | 'deepseek-r1' | 'gemini' | 'gemini-pro' | 'groq-llama' | 'github-gpt4o'
DEFAULT_MODEL=deepseek
DATABASE_PATH=data/brain_bot.sqlite
MAX_CONTEXT_TURNS=20
STREAMING_THROTTLE_SECONDS=1.2
LOG_LEVEL=INFO
